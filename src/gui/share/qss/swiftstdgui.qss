/*
Resources:
http://qt-project.org/doc/qt-5.3/stylesheet-examples.html
http://web.forret.com/tools/color.asp?RGB=2F4F4F&name=Dark+slate+gray

Remarks:
1) there is no opacity with background image, so we need semitransparent images
2) use -- instead of :: for namespaces

Used dynamic properties
framelessMainWindow (infobar.qss , here)
*/

/* fix scroll areas */

/* in flight plan */
/**
QAbstractScrollArea #qw_FlightPlanTabMain { background-color: transparent;QAbstractScrollArea #qw_RemarksGenerator  { background-color: transparent;**/

/* in log component */
/**
QAbstractScrollArea #pg_StatusPageMessages { background-color: black; }
QAbstractScrollArea #pg_StatusPageConsole  { background-color: black; }
**/

/* main GUI parts */

/* style when main window is frameless */
#wi_CentralWidgetOutside[framelessMainWindow="true"] {
  background-color: #F5F5F7;
  margin: 0px;
  border: 1px solid #D2D2D7;
  border-radius: 12px;
}

/* dw_InfoBarStatus has its own style sheet */

#fr_CentralFrameInside {
  margin-right: 5px;
  margin-left: 5px;
  margin-top: 2px;
  margin-bottom: 5px;
}

#gb_AtcStationsOnlineInfo {
  border-style: none;
}

#sw_MainMiddle {
  padding: 3px;
  border: 1px solid #D2D2D7;
  border-radius: 12px;
  background: #FFFFFF;
}

/* close button with frameless windows */
#pb_FramelessCloseButton {
  background: transparent;
  padding: 5px 5px 0px 0px;
  image-position: right;
  margin: 0px;
  border: 0px;
}

/* for FontDialog etc. */
#comp_Settings QToolButton {
  background-color: #007AFF;
  border-style: none;
  border-radius: 6px;
  color: white;
}

#wi_MainKeypadArea QPushButton {
  background-color: transparent;
  color: #6E6E73;
  border: 0px;
  border-radius: 8px;
  margin: 1px;
  max-height: 30px;
  min-height: 30px;
  min-width: 56px;
}

#wi_MainKeypadArea QPushButton:hover {
  background-color: #E5F1FF;
  color: #1D1D1F;
}

#wi_MainKeypadArea QPushButton:checked {
  background-color: #E5F1FF;
  color: #007AFF;
  font-weight: 600;
}

#wi_MainKeypadArea QPushButton#pb_Connect {
  background-color: #007AFF;
  color: white;
  font-weight: 600;
}

#wi_MainKeypadArea QPushButton#pb_Connect:hover {
  background-color: #0066D6;
}

#wi_MainKeypadArea QPushButton#pb_Connect:checked {
  background-color: #34C759;
  color: white;
}

#wi_MainKeypadArea QPushButton:pressed {
  background-color: #CFE5FF;
}

/* login page */
#fr_Buttons QPushButton {
  border-radius: 8px;
  font-weight: 600;
  min-height: 30px;
  min-width: 90px;
}

#fr_Buttons QPushButton#pb_Cancel {
  background-color: #FFFFFF;
  border: 1px solid #D2D2D7;
  color: #1D1D1F;
  font-weight: normal;
}

#fr_Buttons QPushButton#pb_Cancel:hover {
  background-color: #E5F1FF;
}

/* cockpit needs to come after sw_MainMiddle */
#comp_CockpitComComponent QPushButton {
  background-color: transparent;
  border-style: solid;
  border-radius: 6px;
  border-width: 0px;
  border-color: #007AFF;
  color: #007AFF;
  padding: 1px;
  margin: 2px;
}

/* fixes scroll area for audio setup and inner background */
#sa_AudioSetup { background-color: #FFFFFF; }
#sa_AudioComponentInner {
  background-color: #FFFFFF;
}

/* COM panel */
#wip_CockpitComPanelShowHideBar QPushButton {
  background-color: transparent;
  border-style: solid;
  border-radius:3px;
  border-width: 0px;
  border-color: #007AFF;
}

#lep_CommandLineInput {
  background: #FFFFFF;
  margin-bottom: 5px;
  padding: 3px;
  border-radius: 5px;
}

#gb_hotkey #gb_action #gb_machine {
  background: #FFFFFF;
}
