/** style is applied to a CDockWidgetInfoBar **/
/** frameless is dynamic property**/
/** for frameless only use QDockWidget[framelessDockWidget="true"] QFrame **/
/** "xpdrmode", m_transponder.getTransponderMode **/
/** "xpdrmodeshort", m_transponder.getModeAsShortString **/

swift--gui--CDockWidgetInfoBar {
  background: #FFFFFF;
  min-height: 1.25em;
}

swift--gui--CDockWidgetInfoBar[floating="true"] {
  min-width: 50em;
}

swift--gui--Components--CTransponderModeComponent {
  padding: 0px;
  margin:  0px;
}

QToolButton[xpdrmodeshort="I"] {
  background-color: #FF9F0A;
  color: white;
}

QToolButton[xpdrmodeshort="C"] {
  background-color: #34C759;
  color: white;
}

QToolButton[xpdrmodeshort="S"] {
  background-color: #007AFF;
  color: white;
}

swift--gui--Components--CInfoBarStatusComponent {
  padding-left:  1.0em;
  padding-right: 1.0em;
}

QLabel {
  margin: 0px;
  padding-left:  0.5em;
  padding-right: 0.25em;
  padding-bottom: 0px;
  padding-top:    0px;
  border: 0px;
  /**
  background-color: #F5F5F7;
  **/
}

#lbl_ApplicationTitle {
  font-size: 15pt;
  font-weight: 600;
  padding-left: 0px;
}
