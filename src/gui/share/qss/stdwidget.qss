/*
Resources:
http://qt-project.org/doc/qt-5.3/stylesheet-examples.html
http://web.forret.com/tools/color.asp?RGB=2F4F4F&name=Dark+slate+gray

Remarks:
1) there is no opacity with background image, so we need semitransparent images
2) use -- instead of :: for namespaces

Used dynamic properties
framelessMainWindow (infobar.qss , here)
*/

QFrame {
  border-style: solid;
  border-color: transparent;
  border-width: 1px;
}

QCheckBox {
  border: 0px solid green; /* also borders label */
  background: transparent;
}

/* CGuiUtility::checkBoxReadOnly */
/* used for read-only checkboxes */
/* QCheckBox[readOnly="true"] { background: #F2F2F7; } */

QCheckBox::indicator {
  border: 1px solid #D2D2D7;
  border-radius: 4px;
  background: #FFFFFF;
  width: 14px;
  height: 14px;
}

QCheckBox::indicator:checked {
  image: url(:/diagona/icons/diagona/icons/tick.png);
}

QCheckBox::indicator:indeterminate {
  image: url(:/diagona/icons/diagona/icons/question.png);
}

/* Main window */
QMainWindow {
  background-color: #F5F5F7;
}

/* separator between info areas and rest */
/* this hides them */
QMainWindow::separator {
  background: transparent;
  width: 0px;  /* when vertical */
  height: 0px; /* when horizontal */
}

QMainWindow::separator:hover {
  background: transparent;
}

/* Dialog, sometimes main window */
QDialog {
  background-color: #F5F5F7;
}

/* separator between info areas and rest */
/* this hides them */
QDialog::separator {
  background: transparent;
  width: 0px;  /* when vertical */
  height: 0px; /* when horizontal */
}

QDialog::separator:hover {
  background: transparent;
}

/* setup load dialog details frame */
/*
swift--gui--Components--CSetupLoadingDialog #fr_Details {
  background-color: #F5F5F7;
}
*/

QFileDialog #sidebar {
  background: #FFFFFF;
}

QFileDialog QToolButton {
  background: inherit;
}

/*
  Required when dock widget is floating
  1) background-image not working on QDockWidget, so I use direct children for that
  2) seems to have only effect as normal (floating) window
  3) Borders between this widget and the inner child are the margins defined in dockwidget
*/
swift--gui--CDockWidgetInfoArea {
  background-color: #F5F5F7; /* Use green or red here to adjust the borders */
}

/* outer widget in dock widget */
swift--gui--CDockWidgetInfoArea > QWidget[dockwidget="outerwidget"] {
  background: #FFFFFF;
}

/* this is the first widget in the dock area */
/* all dock widgets shall have this QWidget as container */
swift--gui--CDockWidgetInfoArea[framelessDockWidget="true"] > QWidget > QFrame[dockwidget="innerwidget"] {
  margin: 0px;
  padding: 3px;
  border: 1px solid #D2D2D7;
  border-radius: 10px;
}

swift--gui--CDockWidgetInfoArea[framelessDockWidget="false"] > QWidget > QFrame[dockwidget="innerwidget"] {
  /* void */
}

/* required when info area is not floating */
swift--gui--CInfoArea {
  background: #FFFFFF;
}

/* Overlay messages */
swift--gui--COverlayMessages {
  background: transparent; /* background is background color here */
  background: #FFFFFF;
  border: 1px solid #D2D2D7;
  border-radius: 12px;
}

swift--gui--CDropSite {
  color: #6E6E73;
  border: 1px dashed #D2D2D7;
  border-radius: 5px;
  min-height: 18px;
  max-height: 18px;
  margin: 2px;
  padding: 2px;
}

/* Validator bar */
swift--gui--Editors--CValidationIndicator {
  background: #FFFFFF;
}

swift--gui--CPluginDetailsWindow,
swift--gui--CPluginConfigWindow {
  background: #FFFFFF;
}

swift--gui--Components--CDBusServerAddressSelector::disabled {
  background: #F2F2F7;
}

swift--gui--Components--CSimulatorSelector::disabled {
  background: #F2F2F7;
}

swift--gui--Components--CAircraftModelSetValidationDialog,
swift--gui--Components--CCoreSettingsDialog,
swift--gui--Views--CAircraftModelValidationDialog,
swift--gui--Views--CAircraftModelStatisticsDialog,
swift--gui--Components--CSettingsFontDialog,
swift--gui--Components--CAirportDialog,
swift--gui--Components--CTextEditDialog,
swift--gui--Components--CSetupLoadingDialog,
swift--gui--Components--CDownloadComponent,
swift--gui--Components--CDownloadDialog,
swift--gui--Components--CUpdateInfoDialog,
swift--gui--Components--CRawFsdMessagesComponent,
swift--gui--Components--CRawFsdMessagesDialog,
swift--gui--Components--CDbOwnModelsDialog,
swift--gui--Components--CDbOwnModelSetDialog,
swift--gui--Components--CFirstModelSetComponent,
swift--gui--Components--CDbAircraftIcaoComponent,
swift--gui--Components--CDbLiveryComponent,
swift--gui--Components--CDbDistributorComponent,
swift--gui--Components--CLegalInfoComponent,
swift--gui--Components--CStringListDialog
{
  background: #FFFFFF;
}

swift--gui--Components--CCockpitComComponent {
  min-height: 7em;
}

/* default for buttons */
QToolButton {
  background-color: transparent;
  border: 0px;
  border-radius: 4px;
}

QToolButton:hover { background-color: #E5F1FF; }

#tb_AtcStationsAtisReload,
#tb_AtcStationsLoadMetar,
#tb_Audio,
#tb_TextMessageOverlay,
QPushButton {
  background-color: #007AFF;
  border: 0px;
  border-radius: 6px;
  color: white;  /* font color */
  padding: 2px 10px 2px 10px;
  margin-right: 5px;
  min-width:  25px;
  min-height: 20px;
}

QPushButton:hover { background-color: #0066D6; }

QPushButton::disabled {
  background-color: #D2D2D7; /* slated gray if a channel) */
  border-style: none;
  border-radius: 6px;
  color: #6E6E73;
  padding: 2px 10px 2px 10px;
  margin-right: 5px;
  qproperty-textElideMode: ElideMiddle;
}

QPushButton:pressed{ background-color: #0052AB; }

/* Button blinks on to catch the user's attention */
QPushButton[blinkOn="true"] {
  background-color: #5AC8FA;
  color: #1D1D1F;
}

/**
KEYPAD area buttons are in swift GUI stylesheet

QPushButton:checked{ background-color: blue; }
QPushButton:focus:pressed{ background-color: black; }
QPushButton:focus{ background-color: green; }
QPushButton:hover{ background-color: #FF3B30; }
**/

QProgressBar {
  border: 1px solid #D2D2D7;
  border-radius: 5px;
  background-color: #F2F2F7;
  text-align: center;
  padding: 0px;
  height: 16px;
}

QProgressBar::chunk {
  background-color: #007AFF;
  width: 10px;
  margin: 0.5px;
}

QTabWidget::pane { /* The tab widget frame */
  border: none;
}

QTabWidget::tab-bar  {
  left: 5px; /* move to the right by 5px */
}

QTabBar::tab {
  border: 0px;
  border-radius: 6px;
  color: #6E6E73;
  min-width: 30px;
  padding: 3px 8px 3px 8px;
  margin-right: 3px;
}

QTabBar::tab:hover { background-color: #E5F1FF; }

QTabBar::tab::selected {
  background-color: #007AFF;
  color: white;
}

QTabBar::tear {
  image: url(:/own/icons/own/transparent1px.png);
  max-width: 1px;
}

QTabBar QToolButton { /* the scroll buttons are tool buttons */
  background-color: #FFFFFF;
  border: 1px solid #D2D2D7;
}

QSplitter {
  margin: 0px;
  border: 0px;
  padding: 0px;
}

QSplitter::handle {
  background-color: #D2D2D7;
  margin-top: 1px;
  margin-bottom: 1px;
  height: 1px;
}

QSplitter::handle:pressed {
  background-color: #007AFF;
}

/*
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
*/

QLabel {
  background: transparent;
}

QLineEdit {
  background: #FFFFFF;
  border: 1px solid #D2D2D7;
  border-radius: 6px;
  padding: 2px 4px 2px 4px;
  selection-background-color: #007AFF;
}

QLineEdit:focus { border: 1px solid #007AFF; }

QLineEdit[readOnly="true"] {
  background: #F2F2F7;
  border: 1px solid #D2D2D7;
}

QLineEdit:disabled {
  background: #F2F2F7;
  border: 1px solid #D2D2D7;
}

QLineEdit[validation="error"]   { border: 1px solid #FF3B30; }
QLineEdit[validation="warning"] { border: 1px solid #FF9F0A; }
QLineEdit[validation="ok"]      { border: 1px solid #34C759; }

QTextEdit {
  border: 1px solid #D2D2D7;
  background: #FFFFFF;
  border-radius: 6px;
}

QPlainTextEdit {
  border: 1px solid #D2D2D7;
  background: #FFFFFF;
  border-radius: 6px;
}

QGroupBox {
  border: 1px solid #D2D2D7;
  margin-top: 1.5em; /* leave space at the top for the title */
  padding-top: 0.5em;
  border-radius: 10px;
  background: #FFFFFF;
}

QGroupBox::disabled {
  background: #F2F2F7;
}

/* QGroupBox::flat { border: 0px; } */
QGroupBox::unchecked { border: 0px; }

QGroupBox::title {
  left: 0.5em;
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 0px 0.25em 0px 0.25em;
  color: #6E6E73;
}

QToolBox::tab {
  border: 1px solid #D2D2D7;
  border-radius: 6px;
  min-width: 30px;
  padding: 2px;
  padding-left: 4px;
  padding-right: 4px;
}

QToolBox::tab::selected {
  color: white;
  background-color: #007AFF;
}

QToolBox::tab::!selected {
  background-color: #E5F1FF;
}

/* no border on page */
QToolBox > QWidget {
  border: 0px;
}

QComboBox {
  border: 1px solid #D2D2D7;
  border-radius: 6px;
  padding: 2px 4px 2px 4px;
  background: #FFFFFF;
  selection-background-color: #007AFF;
}

QComboBox:disabled {
  background: #F2F2F7;
  border: 1px solid #D2D2D7;
}

/* drop down list */
QComboBox QAbstractItemView {
  background-color: #FFFFFF;
  color: #1D1D1F;
  selection-background-color: #007AFF;
  selection-color: white;
  qproperty-textElideMode: ElideMiddle;
}

/**
QComboBox::drop-down { background-color: yellow; }
QComboBox QListView { }
**/


QDoubleSpinBox {
  border: 1px solid #D2D2D7;
  border-radius: 6px;
  padding: 1px;
  background: #FFFFFF;
}

QSpinBox {
  border: 1px solid #D2D2D7;
  border-radius: 6px;
  padding: 1px;
  background: #FFFFFF;
}

QColorDialog {
  background-color: #F5F5F7;
}

QMenuBar {
  background-color: #F5F5F7;
  padding: 5px 0px 0px 10px;
  margin: 0px 0px 30px 0px; /* removes overlapping bar in frameless mode, why bottom margin helps here, no idea, bug? */
}

QMenuBar::item {
  spacing: 5px; /* spacing between menu bar items */
  padding: 3px 3px;
  background: transparent;
  border-radius: 4px;
}

/* when selected using mouse or keyboard */
QMenuBar::item:selected {
  background: #E5F1FF;
}

QMenuBar::item:pressed {
  background: #E5F1FF;
}

swift--gui--CDockWidgetInfoArea > QMenu > QMenuWidget {
  border: 0px; /* reserve space for selection border */
}

/* reset menu style */
QMenu {
  color: black;
  background-color: white;
  font-style: normal;
  font-weight: normal;
  padding: 5px;
}

/* until Qt 5.12 needed, now since Qt 5.12 causing issue
QMenu::item { padding: 4px 25px 4px 20px; }
**/

/* fix margin style */
QMenu > QFrame {
  color: black;
}

swift--gui--Components--CMarginsInput QLineEdit {
  color: black;
}

QRadioButton::indicator:checked, QRadioButton::indicator:unchecked {
  background-color: #FFFFFF;
  border: 1px solid #D2D2D7;
  border-radius: 7px;
}

QRadioButton::indicator:checked {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5,
    fx: 0.5, fy: 0.5,
    radius: 1.0,
    stop: 0.25 #007AFF,
    stop: 0.3 #FFFFFF
  );
}

QRadioButton::disabled {
  background: #F2F2F7;
  color: #6E6E73;
  border: 0px;
}

QScrollArea {
  border: 1px solid #D2D2D7;
  border-radius: 5px;
}

/* have to set background on widget in scroll area, cannot set directly on scroll area */
/* The inner widget I want to modify is on 2nd level. QScrollArea > QWidget selects too many */
/* http://doc.qt.io/qt-4.8/stylesheet-syntax.html */
QScrollArea > * > QWidget {
  background: #FFFFFF;
}

QScrollArea QMenu {
  border: 1px solid #D2D2D7; /* reserve space for selection border */
  background: #FFFFFF;
  color: black;
  padding: 0px;
}

QScrollBar:horizontal {
  border: 0px;
  background: transparent;
  height: 8px;
  margin: 0px;
}

QScrollBar:vertical {
  border: 0px;
  background: transparent;
  width: 8px;
  margin: 0px;
}

QScrollBar::handle:horizontal {
  background: #C7C7CC;
  border-radius: 4px;
  min-width: 20px;
}

QScrollBar::handle:vertical {
  background: #C7C7CC;
  border-radius: 4px;
  min-height: 20px;
}

QScrollBar::add-line, QScrollBar::sub-line {
  border: 0px;
  background: transparent;
  width: 0px;
  height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QHeaderView::section {
  border: 0px;
  border-bottom: 1px solid #D2D2D7;
  background-color: #F5F5F7;
  color: #6E6E73; /* font */
  padding: 3px;
  margin: 0px;
}

QHeaderView {
  border-width: 0px;
  background-color: #F5F5F7;
}

/* the corner between horizontal and vertical header */
QTableView QTableCornerButton::section {
  background-color: #F5F5F7;
}

/* style the sort indicator */
QHeaderView::down-arrow {
  image: url(:/diagona/icons/diagona/icons/arrow-270-small.png);
  subcontrol-position: bottom left;
}

QHeaderView::up-arrow {
  image: url(:/diagona/icons/diagona/icons/arrow-090-small.png);
  subcontrol-position: bottom left;
}

QTableView, QTreeView, QListView {
  border: 1px solid #D2D2D7; /** outer border **/
  border-radius: 8px;
  background-color: #FFFFFF;
  alternate-background-color: #F5F5F7;
  /** in order to enable alternate color it must be also set to true on view **/
  /** this can be done in code or UI builder **/
  selection-background-color: #007AFF;
  selection-color: white;
  margin-left: 2px;
  margin-right: 2px;
  margin-top: 2px;
  margin-bottom: 2px;
  padding: 1px;
  gridline-color: transparent;
}

/** explicitly setting font color avoids black when pressing CTRL-S **/
QTableView::item:selected {
  background-color: #007AFF;
  color: white;
}

QListView::item:selected {
  background-color: #007AFF;
  color: white;
}

QTreeView {
  show-decoration-selected: 1;
}

QTreeView::item {
  border: 0px;
  padding: 2px 2px 2px 2px;
}

QTreeView::item:hover {
  background: #E5F1FF;
}

QTreeView::item:selected {
  background: #007AFF;
  color: white;
}

QTreeView::branch:open:has-children {
  image: url(:/diagona/icons/diagona/icons/toggle.png);
}

QTreeView::branch:closed:has-children {
  image: url(:/diagona/icons/diagona/icons/toggle-expand.png);
}

QSlider {
  min-height: 2em;
}

QSlider::groove:horizontal {
  border: 0px;
  border-radius: 2px;
  height: 4px; /* the groove expands to the size of the slider by default. by giving it a height, it has a fixed size */
  background: #D2D2D7;
}

QSlider::handle:horizontal {
  background: #FFFFFF;
  border: 1px solid #D2D2D7;
  width: 14px;
  margin: -6px 0; /* handle is placed by default on the contents rect of the groove. Expand outside the groove */
  border-radius: 8px;
}

QSizeGrip {
  image: url(:/diagona/icons/diagona/icons/arrow-in-out.png);
  padding: 0px 20px 0px 0px;
  width: 16px;
  height: 16px;
}

QStatusBar {
  background: transparent;
  min-height: 20px;
}

QStatusBar::item {
  border: none;
}

QStatusBar QLabel {
  border: none;
  padding-left: 5px;
}

#btn_StatusBarWarnsb_MainStatusBar {
  background-color: #FF9F0A;
  color: white;
}

#btn_StatusBarErrorsb_MainStatusBar {
  background-color: #FF3B30;
  color: white;
}

QToolTip {
  color: #1D1D1F;
  background-color: #FFFFFF;
  border: 1px solid #D2D2D7;
}

swift--gui--CLevelMeter {
  qproperty-lowColor: #007AFF;
  border: 1px solid #D2D2D7;
  border-radius: 5px;
  padding: 1px;
  height: 1em;
}

/** T506 supervisor messages **/
QTabBar::tab[supervisormsg=true] { background-color: #FF3B30; }
QTextEdit[supervisormsg=true] { border: 1px solid #FF3B30; margin: 2px; }
QTabBar QToolButton[supervisormsg=true] { background-color: #FF3B30; }
